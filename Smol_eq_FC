            fout.write(f"{waiting_time:.4e} {mean_mass:.4e} {reac_extent:.4e}\n")
            
            # Save histogram every nevery_hist steps
            if step % nevery_hist == 0:
               # masses_values, masses_occurrences = np.unique(masses[masses != 0], return_counts=True)
               # hist = np.column_stack((masses_values, masses_occurrences))
                #sort_indices = np.argsort(unique_masses)
                #masses_values = unique_masses[sort_indices]
                #masses_occurrences = mass_counts[sort_indices]#however, this make the program slower
                hist = np.column_stack((unique_masses,mass_counts))
                np.savetxt(f"{path}/hist_n{step:010d}_waiting_t{waiting_time:.6e}.txt", hist, fmt="%d %d")
                hist_count += 1
                '''
            # Save time_according to time_threshold
            if step % nevery_hist == 0:
               # masses_values, masses_occurrences = np.unique(masses[masses != 0], return_counts=True)
               # hist = np.column_stack((masses_values, masses_occurrences))
                #sort_indices = np.argsort(unique_masses)
                #masses_values = unique_masses[sort_indices]
                #masses_occurrences = mass_counts[sort_indices]#however, this make the program slower
                hist = np.column_stack((unique_masses,mass_counts))
                np.savetxt(f"{path}/hist_n{step:010d}_waiting_t{waiting_time:.6e}.txt", hist, fmt="%d %d")
