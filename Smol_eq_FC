@njit
def k_rate(mi, mj):
    return (mi + mj)**(9/14) * (mi * mj)**(15/14)

def mkdir(path):
    if not os.path.exists(path):
        os.makedirs(path)
        print('Directory created:', path)
    else:
        print('Directory already exists:', path)

def get_unique_masses_and_counts(masses):
    unique_masses, counts = np.unique(masses[masses != 0], return_counts=True)
    return unique_masses, counts

@njit# mass array to unique mass mapping len(masses)=N, len(unique_masses)<<N
def get_index_to_unique_idx(masses, unique_masses):
    index_to_unique_idx = np.zeros(len(masses), dtype=np.int32)  # Explicitly set dtype to int32
    for i, mass in enumerate(masses):
        if mass != 0:
            index_to_unique_idx[i] = np.where(unique_masses == mass)[0][0]
    return index_to_unique_idx

@njit#(parallel=True)# calculate the merger rate of masses in unique_mass array n_u\time n_u which is much smaller than N\times N, here we use a dictionary
def initialize_interaction_map(unique_masses):
    interaction_map = {}
    for i, mi in enumerate(unique_masses):
        for j, mj in enumerate(unique_masses[:i+1]):  # Calculate only once using symmetry
            interaction_map[(mi, mj)] = k_rate(mi, mj)
            interaction_map[(mj, mi)] = interaction_map[(mi, mj)]  # Use symmetry
    return interaction_map

@njit
#initial K_i
def get_K_i(interaction_map, masses, index_to_unique_idx, unique_masses):
    """Efficiently compute initial K_i using unique mass counts and interactions."""
    ntot = len(masses)
    K_i = np.zeros(ntot-1)
    kij=k_rate(masses[0], masses[0])#since intially the mass distribution is monochromatic
    for i in range(ntot-1):
        K_i[i] = kij*(ntot-i)

    return K_i
# Update interaction map after a new mass is formed
def update_unique_masses_and_counts(masses, unique_masses, mass_counts, index_to_unique_idx, i, j, mstorei, mstorej):
    """Updates unique_masses and counts based on the result of merging masses[i] into masses[j]."""

    # Masses after merger
    m_ia = masses[i]
    m_ja = masses[j]

    # Masses before merger
    m_ib = mstorei
    m_jb = mstorej

    def remove_mass_and_adjust_indices(mass, unique_masses, mass_counts, index_to_unique_idx):
        """Helper to remove a mass from unique_masses, adjust counts, and update index_to_unique_idx."""
        if mass in unique_masses:
            mass_idx = np.where(unique_masses == mass)[0][0]
            if mass_counts[mass_idx] > 1:
                mass_counts[mass_idx] -= 1
            else:
                # Remove mass and adjust the index mapping
                unique_masses = np.delete(unique_masses, mass_idx)
                mass_counts = np.delete(mass_counts, mass_idx)
                # Adjust index_to_unique_idx for indices greater than the removed one
                index_to_unique_idx = np.where(
                    index_to_unique_idx > mass_idx,
                    index_to_unique_idx - 1,
                    index_to_unique_idx
                )
        return unique_masses, mass_counts, index_to_unique_idx

    # Remove old masses (m_ib and m_jb) and adjust indices
    unique_masses, mass_counts, index_to_unique_idx = remove_mass_and_adjust_indices(
        m_ib, unique_masses, mass_counts, index_to_unique_idx
    )
    unique_masses, mass_counts, index_to_unique_idx = remove_mass_and_adjust_indices(
        m_jb, unique_masses, mass_counts, index_to_unique_idx
    )

    # Update unique_masses and mass_counts for the new m_ja
    if m_ja in unique_masses:
        j_idxa = np.where(unique_masses == m_ja)[0][0]
        mass_counts[j_idxa] += 1
        index_to_unique_idx[j] = j_idxa
    else:
        # Add new unique mass
        unique_masses = np.append(unique_masses, m_ja)
        mass_counts = np.append(mass_counts, 1)
        j_idxa = len(unique_masses) - 1  # New index
        index_to_unique_idx[j] = j_idxa

    # Mark the original i index in index_to_unique_idx as zero
    index_to_unique_idx[i] = 0

    return unique_masses, mass_counts, index_to_unique_idx

@njit
def update_interaction_map(interaction_map, new_mass, unique_masses):
    """Update the interaction map for the new merged mass."""
    for mi in unique_masses:
        interaction_map[(mi, new_mass)] = k_rate(mi, new_mass)
        interaction_map[(new_mass, mi)] = interaction_map[(mi, new_mass)]  # Use symmetry


@njit
def update_K_i(K_i, interaction_map, masses, index_to_unique_idx, unique_masses, i, j, mstorei,mstorej):
    """update Ki after the merger of i and j, and only update Ki related to this pair """

    non_zero_indices = np.nonzero(masses)[0]  # obtain all the indices of ono-zero components
    n_mol = len(non_zero_indices)
    
    # Case 1: update all  K_i[k] with k < i < j 
    for k in range(i):
        if masses[k] == 0:
            continue
        mk_idx = index_to_unique_idx[k]
        mi_idx = index_to_unique_idx[i]
        mj_idx = index_to_unique_idx[j]
        
        # sbstract the original term of K_rate[m[i],m[k]] and K_rate[m[j],m[k]] and add new K_rate[m[j],m[k]]
        mi, mj, mk = unique_masses[mi_idx], unique_masses[mj_idx], unique_masses[mk_idx]
        K_i[k] -= interaction_map[(mk, mstorei)] + interaction_map[(mk, mstorej)]
        K_i[k] += interaction_map[(mk, mj)]  # m[j] after the updating 
    
    # Case 2: only update the term related to j with k in the range i < k < j 
    for k in range(i + 1, j):
        if masses[k] == 0:
            continue
        mk_idx = index_to_unique_idx[k]
        mj_idx = index_to_unique_idx[j]
        
        
        mk, mj = unique_masses[mk_idx], unique_masses[mj_idx]
        K_i[k] -= interaction_map[(mk, mstorej)]
        K_i[k] += interaction_map[(mk, mj)]  # here m[j] is the one after updating 
    
    # Case 3: calculating K_i[i] and K_i[j]
    K_i[i] = 0  # m[i]=0, K_i[i] must be zero
    
    # recalculate K_i[j]
    if j < len(masses)-1:
        K_i[j] = 0
        for k in range(j + 1, len(masses)):
            if masses[k] == 0:
                continue
            mk_idx = index_to_unique_idx[k]
            mk, mj = unique_masses[mk_idx], unique_masses[mj_idx]
            K_i[j] += interaction_map[(mj, mk)]  # m[j] has been updated
    return K_i
# Select i and j based on cumulative sums, following the full-conditioning method



@njit
def select_molecules(masses, cumulative_K_i, unique_masses, interaction_map, index_to_unique_idx,non_zero_indices,n_mol):
    """First select i based on K_i and then j conditionally based on i."""
    # Select index i from mass array
    select_indice_i =non_zero_indices[:len(non_zero_indices)-1]
    total_sum_i = cumulative_K_i[-1]
    r = np.random.rand() * total_sum_i
    i_idx = np.searchsorted(cumulative_K_i[select_indice_i], r)
    i=select_indice_i[i_idx]
    #if i_idx >= len(masses) or masses[i_idx] == 0:
    #    return None, None  # Invalid selection

    # Now select j conditionally on i
   # mi = masses[i]
    mi_unique_idx = index_to_unique_idx[i]

    # Calculate cumulative sum for selecting j conditioned on i
    cumulative_K_ij = []
    cumulative_sum = 0
    for j_idx in range(i_idx + 1, n_mol):
        #if masses[j_idx] == 0:
        #    continue  # Skip already coagulated masses
        j= non_zero_indices[j_idx]
        #mj = masses[j_idx]
        mj_unique_idx = index_to_unique_idx[j]
        cumulative_sum += interaction_map[(unique_masses[mi_unique_idx], unique_masses[mj_unique_idx])]
        cumulative_K_ij.append(cumulative_sum)

    cumulative_K_ij = np.array(cumulative_K_ij)
    if len(cumulative_K_ij) == 0:
        return None, None  # No valid j found

    # Select j from cumulative sum
    r2 = np.random.rand() * cumulative_sum
    j_relative_idx = np.searchsorted(cumulative_K_ij, r2)
    j = non_zero_indices[i_idx + 1 + j_relative_idx]

    return i, j


# Main simulation
def run_simulation(ntot, density, time_max, nevery_hist, myseed,time_threshold):
    np.random.seed(myseed)
    path = "xx/optimized_simulation_ntot%d_density%.2e" % (ntot, density)
    mkdir(path)

    # Initialize masses array (all monomers initially)
    masses = np.ones(ntot, dtype=int)
    # Initial unique masses and counts
    unique_masses, mass_counts = get_unique_masses_and_counts(masses)
    index_to_unique_idx = get_index_to_unique_idx(masses, unique_masses)

    # Initialize interaction map using symmetry
    interaction_map = initialize_interaction_map(unique_masses)

    # Initial cumulative K_i
    K_i = get_K_i(interaction_map, masses, index_to_unique_idx, unique_masses)
    cumulative_K_i = np.cumsum(K_i)

    # Simulation loop
    with open(f"{path}/mav_vs_t_ntot{ntot}_density{density:.2e}_tmax{time_max:.2e}.txt", "w") as fout:
        waiting_time = float(0.0) # make it more precise
        step = 0
        hist_count = 0
        non_zero_indices = np.nonzero(masses)[0]
        n_mol = len(non_zero_indices)
        history = {}  # Dictionary to store counts of (time_bin, mass[i], mass[j])
        time_threshold=time_threshold# the threshold to store the information
        while waiting_time < time_max and np.count_nonzero(masses) > 1:
            step += 1

            # Select pair (i, j)
            i, j = select_molecules(masses, cumulative_K_i, unique_masses, interaction_map, index_to_unique_idx,non_zero_indices,n_mol)
