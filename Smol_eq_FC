            unique_masses, mass_counts, index_to_unique_idx = update_unique_masses_and_counts(masses,unique_masses, mass_counts, index_to_unique_idx, i, j,mstorei,mstorej)
            update_interaction_map(interaction_map, new_mass, unique_masses)
            # Update only relevant cumulative K_i from i onward
            K_i = update_K_i(K_i, interaction_map, masses, index_to_unique_idx, unique_masses, i, j, mstorei,mstorej)
            #K_i[i:]=get_K_i(interaction_map, masses, index_to_unique_idx, unique_masses)[i:]
            cumulative_K_i = np.cumsum(K_i)
            #print(total_sum)
