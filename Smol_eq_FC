# Run the simulation with default parameters, we must make sure that time_threshold>=nevery_hist
def run_simulation_multi(N):
     run_simulation(ntot=N, density=1.0, time_max=1e5, nevery_hist=10, myseed=123,time_threshold=10)

# Wrap the original function and add timing
def run_with_timing(n):
    t0 = time.time()
    run_simulation_multi(n)
    elapsed = time.time() - t0
    # Return a tuple: (parameter, calculation result, computation time)
    return n,elapsed
# -----------------------------------------------------------------------------
# Main Entry: Parse Parameters, Initialize, and Parallel Scheduling
# -----------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(description="Multiprocessing parameter scan program")
    parser.add_argument("--N_list", type=int, nargs="+", required=True,
                        help=""Multi-process parameter scanning program, for example：1000 10000 20000")
    parser.add_argument("--processes", type=int, default=None,
                        help="Number of processes (uses all CPU cores by default)")
    args = parser.parse_args()

    # Record the global start time (optional)
    overall_t0 = time.time()

    # Call run_with_timing in parallel instead of the original run_simulation_multi
    with Pool(processes=args.processes) as pool:
        try:
            results = []
            total = len(args.N_list)
            for i, (n, elapsed) in enumerate(
                    pool.imap_unordered(run_with_timing, args.N_list), start=1):
                results.append((n, elapsed))
                print(f"process: {i}/{total}  parameter n={n} timing {elapsed:.3f}s", end='\r')
            # Sort in the original order
            results.sort(key=lambda x: args.N_list.index(x[0]))
        except KeyboardInterrupt:
            print("\n User interrupted, saving partial results…")
        except Exception as e:
            print(f"\n: An unexpected error occurred: {e}")

    overall_elapsed = time.time() - overall_t0

    # write in the result file
    with open("timingoutput.txt", "w") as f:
        f.write(f"# Parameter scan results (a total of {len(results)} items), total elapsed time {overall_elapsed:.3f}s\n")
        f.write("n\tresult\telapsed[s]\n")
        for n,elapsed in results:
            f.write(f"{n}\t{elapsed:.6f}\n")

    print(f"\n  Computation complete！Total elapsed time {overall_elapsed:.2f}s，see output.txt")

if __name__ == "__main__":
    main()
